# sshfs er installert manuelt – finnes ikke ARM-versjon i brew

# Språk valgt i setup.sh (lagret i ~/.config/dotfiles/langs, ett per linje)
langs_file = File.expand_path("~/.config/dotfiles/langs")
if File.exist?(langs_file)
  File.readlines(langs_file, chomp: true).reject(&:empty?).each do |lang|
    lang_brewfile = File.expand_path("~/.dotfiles/langs/#{lang}/Brewfile")
    instance_eval(File.read(lang_brewfile), lang_brewfile) if File.exist?(lang_brewfile)
  end
end
